# Pebble Module 02 — example environment.
#
# Copy to `.env` (or `.env.local` for the web app) and fill in as needed.
# EVERYTHING IS OPTIONAL FOR LOCAL DEV: with no values set, the app runs on
# embedded PGlite with a dev admin user, stub email/WhatsApp providers, a stub
# PDF renderer, and local file storage — zero cloud credentials required.
# Production (GCP) wires the same variables via Secret Manager (see infra/).

# ─────────────────────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────────────────────
# Postgres connection string. When SET (and not forced to PGlite), the app uses
# node-postgres against Cloud SQL. When UNSET, it uses embedded PGlite.
# DATABASE_URL=postgresql://pebble:password@localhost:5432/pebble
# PGlite data directory. "memory://" is ephemeral (tests); a path persists dev
# data. Defaults to "memory://" when unset.
PGLITE_DIR=.data/dev
# Seed the database on boot (dev convenience; used by the smoke test).
# SEED_ON_BOOT=1

# ─────────────────────────────────────────────────────────────────────────────
# Auth (web app) — exact variable set is owned by @pebble/web
# ─────────────────────────────────────────────────────────────────────────────
# "dev" (default) returns a dev admin user with zero cloud creds; "firebase"
# enables Google sign-in with db-backed roles (admin / estimator / approver).
# The session lives in the httpOnly cookie "__pebble_session" (14-day TTL,
# sameSite=lax; `secure` in production builds).
AUTH_MODE=dev
# Firebase client config (public — safe to expose to the browser). All four are
# required for the /login Google sign-in button; when unset, /login shows a
# "Firebase not configured" card instead.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
# NEXT_PUBLIC_FIREBASE_APP_ID=
# Firebase Admin (server) — verifies ID tokens and mints session cookies.
# Credentials via GOOGLE_APPLICATION_CREDENTIALS locally (ambient ADC on Cloud
# Run); FIREBASE_PROJECT_ID pins the project id when ADC doesn't carry one.
# FIREBASE_PROJECT_ID=your-project
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# Sign-in allowlist — REQUIRED in firebase mode. Fail closed: with NEITHER set,
# every Google account is rejected. Comma-separated emails and/or one domain.
# First login of an allowlisted account is provisioned as "estimator"; admins
# promote via /admin/users.
# PEBBLE_ALLOWED_EMAILS=ops@greenberg.example,sales@greenberg.example
# PEBBLE_ALLOWED_DOMAIN=greenberg.example
# Test escape hatch (firebase mode only): act as this stored user uid without a
# session cookie. Never set in production.
# PEBBLE_SESSION_UID=

# ─────────────────────────────────────────────────────────────────────────────
# AI models + keys (router: Gemini Flash retrieval, Claude Sonnet default,
# Opus 4.8 escalation). Model ids are env-overridable — override the two Claude
# ids below to pin/upgrade the chat lane without a redeploy (e.g. claude-sonnet-5).
# ─────────────────────────────────────────────────────────────────────────────
PEBBLE_CLAUDE_DEFAULT_MODEL=claude-sonnet-4-6
PEBBLE_CLAUDE_OPUS_MODEL=claude-opus-4-8
PEBBLE_GEMINI_MODEL=gemini-3.5-flash
# Required for the chat (Claude) lane — without it /api/chat returns a graceful
# 503 and the structured screens still work.
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_GENERATIVE_AI_API_KEY=...
# Per-user daily LLM spend cap (USD) for the chat lane; over it → HTTP 429.
# Resets at UTC midnight. Defaults to 5 when unset.
# PEBBLE_DAILY_LLM_BUDGET_USD=5

# ─────────────────────────────────────────────────────────────────────────────
# Dispatch — Email (Resend)
# ─────────────────────────────────────────────────────────────────────────────
# When RESEND_API_KEY is unset, the stub email provider is used (no network).
# RESEND_API_KEY=re_...
# Verified sender. Defaults to Greenberg's verified address when unset.
# DISPATCH_EMAIL_FROM=Greenberg Estimates <estimates@greenberg.example>

# ─────────────────────────────────────────────────────────────────────────────
# Dispatch — WhatsApp (pluggable provider)
# ─────────────────────────────────────────────────────────────────────────────
# Provider: "stub" (default, zero-config), "aisensy", or "gupshup". Missing
# credentials fall back to the stub with a warning (never throws).
WHATSAPP_PROVIDER=stub
# AiSensy
# AISENSY_API_KEY=
# AISENSY_CAMPAIGN_NAME=
# AISENSY_USER_NAME=
# AISENSY_API_URL=            # override for tests/self-hosted
# Gupshup
# GUPSHUP_API_KEY=
# GUPSHUP_SOURCE=             # registered WhatsApp source number
# GUPSHUP_APP_NAME=
# GUPSHUP_API_URL=            # override for tests/self-hosted

# ─────────────────────────────────────────────────────────────────────────────
# Storage (rendered PDF/XLSX)
# ─────────────────────────────────────────────────────────────────────────────
# "gcs" uses Google Cloud Storage (requires GCS_BUCKET); anything else uses the
# local filesystem adapter — the zero-config default.
STORAGE_BACKEND=local
# GCS_BUCKET=your-project-pebble-outputs
# Local storage directory (used when STORAGE_BACKEND != gcs). Default .data/outputs.
LOCAL_STORAGE_DIR=.data/outputs

# ─────────────────────────────────────────────────────────────────────────────
# PDF rendering (worker, or the web app when rendering in-process)
# ─────────────────────────────────────────────────────────────────────────────
# Absolute path to a Chromium/Chrome binary. When set, the worker renders real
# PDFs with playwright-core; the container image sets this to /usr/bin/chromium.
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=/usr/bin/chromium
# Alternatively force the real renderer via the installed "chrome" channel.
# When neither is set, a deterministic stub renderer is used (tests / no browser).
# RENDER_PDF=1

# ─────────────────────────────────────────────────────────────────────────────
# Service wiring (web → worker)
# ─────────────────────────────────────────────────────────────────────────────
# Worker HTTP port (Cloud Run injects PORT; default 8080).
PORT=8080
# URL the web app uses to reach the worker service for render/dispatch tasks.
#
# LEAVE UNSET FOR LOCAL DEV. PGlite is single-process (file lock), so a
# separate local worker cannot share the web app's PGLITE_DIR; with WORKER_URL
# unset, the web app runs the worker's task handlers IN-PROCESS on its own db
# handle. In that mode the PDF/storage env above applies to the WEB process:
# rendered files land under the web app's LOCAL_STORAGE_DIR (default
# .data/outputs) and PDFs use the stub renderer unless RENDER_PDF=1 /
# PLAYWRIGHT_CHROMIUM_EXECUTABLE is set for the web process.
#
# In production (Cloud SQL via DATABASE_URL) set this to the worker service
# URL; on GCP (detected via K_SERVICE / GOOGLE_APPLICATION_CREDENTIALS) each
# request carries an OIDC identity token minted for this audience.
# WORKER_URL=http://localhost:8080
