{
  "name": "pebble",
  "private": true,
  "version": "0.1.0",
  "description": "Pebble v1.0 — Module 02: Estimate Crafting Space (Greenberg Enterprises × Softpiper Solutions)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @pebble/db db:generate",
    "db:migrate": "pnpm --filter @pebble/db db:migrate",
    "db:seed": "pnpm --filter @pebble/db db:seed"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
