# syntax=docker/dockerfile:1
#
# Pebble Module 02 — @pebble/web (Next.js 15) production image for Cloud Run.
#
# Multi-stage pnpm build. Workspace packages ship TypeScript *source* and are
# transpiled by Next (`transpilePackages` in next.config.ts). The runner is a
# **prod-installed workspace** serving the prebuilt .next via `next start`.
#
# Why not Next's standalone output: the app force-externalises its node-only
# packages (pglite/pg/exceljs/firebase-admin/google-*) through a custom webpack
# `externals` function — required to keep them require()-able at runtime — and
# that defeats Next's output file tracing, which then ships an (almost) empty
# node_modules. A prod pnpm install is ~200MB heavier but always complete.

# ── Base: Node 22 + pnpm (pinned via corepack to the repo's packageManager) ──
FROM node:22-slim AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable
WORKDIR /app

# ── Dependencies: install against the frozen lockfile, cached on manifests ──
FROM base AS deps
# Copy only the manifests first so the (slow) install layer is reused whenever
# source — but not dependencies — changes.
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/web/package.json ./apps/web/
COPY apps/worker/package.json ./apps/worker/
COPY packages/ai/package.json ./packages/ai/
COPY packages/db/package.json ./packages/db/
COPY packages/dispatch/package.json ./packages/dispatch/
COPY packages/documents/package.json ./packages/documents/
COPY packages/engines/package.json ./packages/engines/
COPY packages/expr/package.json ./packages/expr/
COPY packages/mcp/package.json ./packages/mcp/
COPY packages/shared/package.json ./packages/shared/
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile

# ── Build: bring in the full source and produce .next ──
FROM deps AS build
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
# Firebase *client* config is inlined into the browser bundle by `next build`,
# so it must arrive as build args (public identifiers, not secrets).
ARG NEXT_PUBLIC_FIREBASE_API_KEY
ARG NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN
ARG NEXT_PUBLIC_FIREBASE_PROJECT_ID
ARG NEXT_PUBLIC_FIREBASE_APP_ID
ENV NEXT_PUBLIC_FIREBASE_API_KEY=$NEXT_PUBLIC_FIREBASE_API_KEY \
    NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=$NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN \
    NEXT_PUBLIC_FIREBASE_PROJECT_ID=$NEXT_PUBLIC_FIREBASE_PROJECT_ID \
    NEXT_PUBLIC_FIREBASE_APP_ID=$NEXT_PUBLIC_FIREBASE_APP_ID
RUN pnpm --filter @pebble/web build

# ── Prune: prod-only node_modules for the whole workspace ──
FROM base AS prune
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/web/package.json ./apps/web/
COPY apps/worker/package.json ./apps/worker/
COPY packages/ai/package.json ./packages/ai/
COPY packages/db/package.json ./packages/db/
COPY packages/dispatch/package.json ./packages/dispatch/
COPY packages/documents/package.json ./packages/documents/
COPY packages/engines/package.json ./packages/engines/
COPY packages/expr/package.json ./packages/expr/
COPY packages/mcp/package.json ./packages/mcp/
COPY packages/shared/package.json ./packages/shared/
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile --prod

# ── Runner: prod workspace + prebuilt .next, served by next start ──
FROM base AS runner
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
# Cloud Run injects PORT; apps/web's start script passes it through to next.
ENV PORT=3000

# Prod workspace: manifests + node_modules (root store + per-package symlink
# dirs), copied as one tree so pnpm's symlink layout stays internally
# consistent.
COPY --from=prune /app ./

# App source + built .next (workspace package sources come along for
# next.config.ts's transpilePackages resolution; the heavy compilation is
# already inside .next).
COPY --from=build /app/apps/web/next.config.ts /app/apps/web/postcss.config.mjs /app/apps/web/tsconfig.json /app/apps/web/next-env.d.ts ./apps/web/
COPY --from=build /app/apps/web/app ./apps/web/app
COPY --from=build /app/apps/web/src ./apps/web/src
COPY --from=build /app/apps/web/middleware.ts ./apps/web/middleware.ts
COPY --from=build /app/apps/web/.next ./apps/web/.next
COPY --from=build /app/packages ./packages

EXPOSE 3000
CMD ["pnpm", "--filter", "@pebble/web", "start"]
